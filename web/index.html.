<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>InterpelliScuola Nazionale - Live</title>
<style>
  :root{ --bg:#0B1220; --surface:#121B2E; --border:#26324A; --text:#E9EEF9; --text-dim:#93A2C3; --accent:#3E7BFA; }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,sans-serif;}
  header{padding:20px;border-bottom:1px solid var(--border);}
  h1{margin:0;font-size:20px;}
  .sub{color:var(--text-dim);font-size:13px;margin-top:4px;}
  .filters{display:flex;gap:10px;flex-wrap:wrap;padding:16px 20px;border-bottom:1px solid var(--border);}
  select,input{background:var(--surface);border:1px solid var(--border);color:var(--text);padding:8px 10px;border-radius:6px;font-size:13px;}
  table{width:100%;border-collapse:collapse;font-size:13px;}
  th,td{padding:10px 14px;text-align:left;border-bottom:1px solid var(--border);}
  th{color:var(--text-dim);font-weight:600;font-size:11px;text-transform:uppercase;}
  a.btn{color:var(--accent);text-decoration:none;font-weight:600;}
  #status{padding:20px;color:var(--text-dim);}
</style>
</head>
<body>
<header>
  <h1>InterpelliScuola Nazionale — Live</h1>
  <div class="sub" id="freshness">Caricamento in corso...</div>
</header>
<div class="filters">
  <select id="fRegione"><option value="">Tutte le regioni</option></select>
  <select id="fProvincia"><option value="">Tutte le province</option></select>
  <input type="text" id="fSearch" placeholder="Cerca scuola, comune, classe...">
</div>
<div id="status"></div>
<div style="overflow-x:auto;">
<table>
  <thead><tr><th>Scuola</th><th>Localita</th><th>Classe</th><th>Pubblicato</th><th>Scadenza</th><th>Link</th></tr></thead>
  <tbody id="tbody"></tbody>
</table>
</div>

<script>
const SUPABASE_URL = "https://beehymkhsmkgbbtllbvk.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJlZWh5bWtoc21rZ2JidGxsYnZrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk4NjgyOTQsImV4cCI6MjEwNTQ0NDI5NH0.DsV9Z5HilXzPMLVVkQYTVryO11JP0NWF7SUfQA8keF0";

let allRecords = [];

async function loadData(){
  const statusEl = document.getElementById("status");
  try{
    const res = await fetch(`${SUPABASE_URL}/rest/v1/interpelli?select=*&order=data_pubblicazione.desc`, {
      headers: { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}` }
    });
    if(!res.ok) throw new Error("HTTP " + res.status);
    allRecords = await res.json();
    document.getElementById("freshness").textContent =
      allRecords.length + " interpelli in database, aggiornati automaticamente ogni ora.";
    populateFilters();
    render();
  }catch(err){
    statusEl.textContent = "Errore nel caricamento dei dati: " + err.message;
  }
}

function populateFilters(){
  const regioni = [...new Set(allRecords.map(r => r.regione).filter(Boolean))].sort();
  const fRegione = document.getElementById("fRegione");
  regioni.forEach(r => { const o = document.createElement("option"); o.value = r; o.textContent = r; fRegione.appendChild(o); });
}

function render(){
  const regione = document.getElementById("fRegione").value;
  const provincia = document.getElementById("fProvincia").value.toLowerCase();
  const search = document.getElementById("fSearch").value.trim().toLowerCase();
  const filtered = allRecords.filter(r => {
    if(regione && r.regione !== regione) return false;
    if(provincia && (r.provincia||"").toLowerCase() !== provincia) return false;
    if(search){
      const hay = [r.scuola, r.comune, r.classe_concorso].join(" ").toLowerCase();
      if(!hay.includes(search)) return false;
    }
    return true;
  });
  document.getElementById("tbody").innerHTML = filtered.map(r => `
    <tr>
      <td>${esc(r.scuola||"-")}</td>
      <td>${esc(r.comune||"-")}, ${esc(r.provincia||"-")}</td>
      <td>${esc(r.classe_concorso||"-")}</td>
      <td>${esc(r.data_pubblicazione||"-")}</td>
      <td>${esc(r.data_scadenza||"-")}</td>
      <td>${r.url_diretto ? `<a class="btn" href="${esc(r.url_diretto)}" target="_blank" rel="noopener">Apri</a>` : ""}</td>
    </tr>`).join("");
}

function esc(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

document.getElementById("fRegione").addEventListener("change", render);
document.getElementById("fProvincia").addEventListener("input", render);
document.getElementById("fSearch").addEventListener("input", render);

loadData();
</script>
</body>
</html>
